{
  "kind": "message-type",
  "format_version": "0.1.0",
  "id": "example.state-estimate",
  "version": "0.1.0",
  "status": "stable",
  "summary": "State estimates per series and variable (example).",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "time_unit",
      "estimates"
    ],
    "properties": {
      "time_unit": {
        "type": "string",
        "minLength": 1
      },
      "estimates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "series_id",
            "variable_id",
            "time",
            "value",
            "basis"
          ],
          "properties": {
            "series_id": {
              "type": "string",
              "minLength": 1
            },
            "variable_id": {
              "type": "string",
              "minLength": 1
            },
            "time": {
              "type": "number"
            },
            "value": {
              "type": "number"
            },
            "basis": {
              "enum": [
                "observation",
                "blend",
                "prior"
              ]
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        }
      }
    },
    "patternProperties": {
      "^x-": {}
    },
    "additionalProperties": false
  }
}
