{
  "kind": "message-type",
  "format_version": "0.1.0",
  "id": "pmp.prediction-set",
  "version": "0.1.0",
  "status": "stable",
  "summary": "Predictions issued at one logical time (long form).",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "issued_at",
      "time_unit",
      "predictions"
    ],
    "properties": {
      "issued_at": {
        "type": "number",
        "description": "The logical time of issue."
      },
      "time_unit": {
        "type": "string",
        "minLength": 1
      },
      "predictions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "series_id",
            "variable_id",
            "time",
            "prediction_kind",
            "value"
          ],
          "properties": {
            "series_id": {
              "type": "string",
              "minLength": 1
            },
            "variable_id": {
              "type": "string",
              "minLength": 1
            },
            "time": {
              "type": "number"
            },
            "prediction_kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Documented values: latent_mean, observation, state, residual, quantile."
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            },
            "draw": {
              "type": "integer",
              "minimum": 0
            },
            "quantile": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "prediction_kind": {
                "const": "quantile"
              }
            },
            "required": [
              "prediction_kind"
            ]
          },
          "then": {
            "required": [
              "quantile"
            ]
          },
          "else": {
            "not": {
              "required": [
                "quantile"
              ]
            }
          }
        }
      }
    },
    "patternProperties": {
      "^x-": {}
    },
    "additionalProperties": false
  }
}
