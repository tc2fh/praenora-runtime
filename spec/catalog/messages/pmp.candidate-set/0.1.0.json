{
  "kind": "message-type",
  "format_version": "0.1.0",
  "id": "pmp.candidate-set",
  "version": "0.1.0",
  "status": "draft",
  "summary": "A population of candidate models with their parameters and statuses (draft).",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "candidates"
    ],
    "properties": {
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "model",
            "parameters",
            "status",
            "origin"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "object",
              "required": [
                "href",
                "sha256"
              ],
              "properties": {
                "href": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false
            },
            "parameters": {
              "type": "object"
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "type": "string",
              "minLength": 1
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        }
      }
    },
    "patternProperties": {
      "^x-": {}
    },
    "additionalProperties": false
  }
}
