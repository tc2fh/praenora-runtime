{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praenora:schema:message-type:0.1",
  "title": "Praenora message type",
  "description": "A catalog entry: a message type and the JSON Schema of its data.",
  "type": "object",
  "required": [
    "kind",
    "format_version",
    "id",
    "version",
    "status",
    "schema"
  ],
  "properties": {
    "kind": {
      "const": "message-type"
    },
    "format_version": {
      "$ref": "#/$defs/semver"
    },
    "id": {
      "$ref": "#/$defs/catalog_id"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "summary": {
      "type": "string"
    },
    "schema": {
      "type": "object",
      "description": "A JSON Schema of the data: 2020-12, or draft-07 when it declares that or declares no $schema."
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    }
  }
}
