{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praenora:schema:capability-definition:0.1",
  "title": "Praenora capability definition",
  "description": "A catalog entry: the typed input and output ports of a capability.",
  "type": "object",
  "required": [
    "kind",
    "format_version",
    "id",
    "version",
    "status",
    "inputs",
    "outputs"
  ],
  "properties": {
    "kind": {
      "const": "capability-definition"
    },
    "format_version": {
      "$ref": "#/$defs/semver"
    },
    "id": {
      "$ref": "#/$defs/catalog_id"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "summary": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "patternProperties": {
        "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/capability_port"
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "patternProperties": {
        "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/capability_port"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "capability_port": {
      "type": "object",
      "required": [
        "type",
        "type_version",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/catalog_id"
        },
        "type_version": {
          "$ref": "#/$defs/semver"
        },
        "required": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    }
  }
}
