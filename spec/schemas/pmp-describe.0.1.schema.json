{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praenora:schema:pmp-describe:0.1",
  "title": "PMP describe document",
  "description": "The identity a module reports through describe().",
  "type": "object",
  "required": [
    "name",
    "version",
    "abi",
    "sdk_version",
    "pmp_version",
    "capabilities"
  ],
  "properties": {
    "name": {
      "$ref": "#/$defs/module_name"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "abi": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false,
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sdk_version": {
      "$ref": "#/$defs/semver"
    },
    "pmp_version": {
      "$ref": "#/$defs/semver"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability_ref"
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "capability_ref": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/catalog_id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "module_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
