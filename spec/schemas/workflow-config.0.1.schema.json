{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praenora:schema:workflow-config:0.1",
  "title": "Praenora workflow configuration",
  "description": "Pins a workflow definition and binds its inputs and steps to data and modules.",
  "type": "object",
  "required": [
    "kind",
    "format_version",
    "workflow",
    "steps"
  ],
  "properties": {
    "kind": {
      "const": "workflow-config"
    },
    "format_version": {
      "$ref": "#/$defs/semver"
    },
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/catalog_id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0
        },
        "ticks": {
          "$ref": "#/$defs/count"
        },
        "time": {
          "$ref": "#/$defs/time_base"
        },
        "timeouts": {
          "$ref": "#/$defs/timeouts"
        },
        "isolation": {
          "$ref": "#/$defs/isolation"
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "patternProperties": {
        "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$": {
          "type": "object",
          "required": [
            "source"
          ],
          "anyOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "descriptor"
              ]
            }
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "observation-csv",
                "json-document"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "descriptor": {
              "type": "string",
              "minLength": 1,
              "description": "An ode-uq-spec target descriptor of an observation-csv input; it names the CSV (data.href) and gives its dialect, column mapping and variables."
            },
            "columns": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "object",
      "patternProperties": {
        "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$": {
          "type": "object",
          "required": [
            "module"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "$ref": "#/$defs/module_ref"
            },
            "parameters": {
              "type": "object"
            },
            "timeouts": {
              "$ref": "#/$defs/timeouts"
            },
            "isolation": {
              "$ref": "#/$defs/isolation"
            },
            "log_level": {
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error",
                "critical",
                "off"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ]
        },
        "record": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$"
          }
        },
        "trace_messages": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_level": {
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "critical",
            "off"
          ]
        },
        "log_format": {
          "enum": [
            "text",
            "json"
          ]
        },
        "log_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_interval": {
          "$ref": "#/$defs/duration"
        }
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration": {
      "$comment": "A duration is either a string <number><unit> with unit ns, us, ms, s, m or h (\"30s\", \"1.5m\"; \"0\" or \"none\" disables the timeout), or the integer 0, which also disables it. The pattern applies only to strings and minimum/maximum only to numbers, so every other number is rejected.",
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^(none|0|[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))$",
      "minimum": 0,
      "maximum": 0,
      "description": "<number><unit> with unit ns|us|ms|s|m|h; 0 or none disables."
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "in-process",
            "process"
          ],
          "default": "in-process",
          "description": "Where the step's module instance runs: in the runtime's process, or in a module host, a process of its own."
        },
        "share_compiled_models": {
          "type": "boolean",
          "default": false,
          "description": "Whether the step's module host shares compiled models with the module hosts of the other steps that share them, through a store in the runtime's process. Only for a step whose mode is process."
        },
        "sandbox": {
          "enum": [
            "none",
            "restricted"
          ],
          "default": "none",
          "description": "The sandbox profile the step's module host applies to itself before it loads any library: none, or restricted, which keeps the module host's own process from the network, from starting processes and from writing files outside its own temporary directory (macOS only; not a boundary against a module meant to do harm). Only for a step whose mode is process."
        }
      },
      "description": "How a step's module instance is isolated. At run.isolation, the default of every step; at steps.<id>.isolation, that step's. Resolved field by field: the step's field, else the run's, else the default."
    },
    "module_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "module_ref": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/module_name"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "time_base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "default": "1"
        },
        "start": {
          "type": "number",
          "default": 0.0
        },
        "period": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.0
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invoke": {
          "$ref": "#/$defs/duration"
        },
        "lifecycle": {
          "$ref": "#/$defs/duration"
        },
        "cancel_grace": {
          "$ref": "#/$defs/duration"
        }
      }
    }
  }
}
