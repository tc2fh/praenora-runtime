{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praenora:schema:module-manifest:0.2",
  "title": "Praenora Module Manifest",
  "description": "Describes one native module library: identity, ABI, platform, capabilities, parameters and the runtime services it requires or can use. Discovered as *.pmm.json files.",
  "type": "object",
  "required": [
    "kind",
    "format_version",
    "module",
    "abi",
    "pmp_version",
    "sdk_version",
    "library",
    "platform",
    "capabilities"
  ],
  "properties": {
    "kind": {
      "const": "module-manifest"
    },
    "format_version": {
      "$ref": "#/$defs/semver"
    },
    "module": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/module_name"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "summary": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repository": {
          "type": "string"
        }
      }
    },
    "abi": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false,
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pmp_version": {
      "$ref": "#/$defs/semver"
    },
    "sdk_version": {
      "$ref": "#/$defs/semver"
    },
    "library": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative to the manifest's directory."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependency_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "required": [
        "os",
        "arch"
      ],
      "additionalProperties": false,
      "properties": {
        "os": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "arch": {
          "enum": [
            "x86_64",
            "arm64"
          ]
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability_ref"
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service_requirement"
          },
          "description": "The runtime services the module requires (optional false) or can use (optional true); unique by name and major."
        }
      }
    },
    "parameters_schema": {
      "type": "object",
      "description": "A draft-07 schema of the step parameters."
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "enum": [
            "module",
            "instance"
          ],
          "default": "module"
        },
        "cancellation": {
          "type": "boolean",
          "default": false
        },
        "diagnostics": {
          "type": "boolean",
          "default": false
        },
        "self_test": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vectors": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "capability_ref": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/catalog_id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "module_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "service_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "service_requirement": {
      "type": "object",
      "required": [
        "name",
        "major"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/service_name"
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
