{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praenora:schema:module-check-report:0.1",
  "title": "Praenora module check report",
  "description": "The results of the contract checks of one module.",
  "type": "object",
  "required": [
    "kind",
    "format_version",
    "passed",
    "checks"
  ],
  "properties": {
    "kind": {
      "const": "module-check-report"
    },
    "format_version": {
      "$ref": "#/$defs/semver"
    },
    "manifest": {
      "type": "string"
    },
    "module": {
      "$ref": "#/$defs/module_ref"
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "module_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "module_ref": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/module_name"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
